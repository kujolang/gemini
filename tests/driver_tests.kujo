test_setup { from src.provider import gemini_provider, gemini_driver }
test "driver contract and native request mapping" { p:=gemini_provider({"model":"gemini-test"}); d:=gemini_driver(); assert_equal(d["version"],"1.0.0"); e:=d["encode_chat"]({"provider":p,"credential":"secret","messages":[{"role":"user","content":"hi"}],"resolved_options":{"model":"gemini-test","stream":false}}); assert_equal(contains(e["url"],"generateContent"),1); assert_equal(e["headers"]["x-goog-api-key"],"secret") }
test "driver decodes candidates usage and finish" { d:=gemini_driver(); r:=d["decode_chat"]({"fallback_model":"m","data":{"candidates":[{"content":{"parts":[{"text":"ok"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":4,"candidatesTokenCount":2}}}); assert_equal(r["output_text"],"ok"); assert_equal(r["finish_reason"],"stop"); assert_equal(r["usage"]["total_tokens"],6) }

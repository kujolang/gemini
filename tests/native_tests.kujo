test_setup { from src.gemini import create_client, client_generate_content, parse_stream }
test "client validates HTTPS and uses protected API key header" { c:=create_client({"base_url":"https://generativelanguage.googleapis.com/v1beta","api_key":"secret","transport":func(url,o) { assert_equal(o["_headers"]["x-goog-api-key"],"secret"); return Ok({"_status":200,"_body":"{\"ok\":true}"}) }}); assert_true(client_generate_content(c,"gemini-test",[],{})["ok"]); assert_true(create_client({"base_url":"http://remote.example"})["validation_error"]!="") }
test "SSE stream parser handles additive events and malformed data" { p:=parse_stream(["data: {\"candidates\":[{\"content\":{\"parts\":[{\"text\":\"A\"}]}}]}\n\n","event: done\ndata: {\"x\":1}\n\n"],""); assert_true(p["ok"]); assert_equal(len(p["events"]),2); assert_false(parse_stream(["data: bad\n\n"],"")["ok"]) }
test "native errors redact credentials" { c:=create_client({"api_key":"secret","transport":func(url,o) { return Ok({"_status":401,"_body":"{\"error\":{\"message\":\"secret denied\"}}"}) }}); r:=client_generate_content(c,"m",[],{}); assert_false(r["ok"]); assert_equal(contains(r["message"],"secret"),0) }

func get(o,k,f) { if type(o)=="dict" && has_key(o,k) { return o[k] }; return f }
func provider_impl(config) { if type(config)!="dict" { config:={} }; return {"name":"gemini","base_url":get(config,"base_url","https://generativelanguage.googleapis.com/v1beta"),"default_model":get(config,"model",""),"api_key_env":"GEMINI_API_KEY","capabilities":{"streaming":true,"tool_calls":true,"structured_output":true,"vision":true,"embeddings":true},"driver":driver()} }
func describe(p) { return {"id":"gemini-native","protocol":"gemini-generate-content","auth":{"mode":"x-goog-api-key","allow_anonymous":false},"capabilities":p["capabilities"]} }
func validate(p) { if type(p)!="dict" || get(p,"base_url","")=="" { return {"ok":false,"errors":[{"field":"base_url","message":"Gemini provider requires a base URL."}] } }; return {"ok":true,"errors":[]} }
func encode_chat(ctx) { o:=ctx["resolved_options"]; contents:=[]; for m in ctx["messages"] { contents=push(contents,{"role":get(m,"role","user"),"parts":[{"text":get(m,"content","")}]}) }; body:={"contents":contents}; if has_key(o,"system_instruction") { body["systemInstruction"]:={"parts":[{"text":o["system_instruction"]}]} }; gen:={}; for k in ["temperature","top_p","top_k","max_output_tokens","stop_sequences","response_mime_type","response_schema"] { if has_key(o,k) { gen[k]:=o[k] } }; if len(gen)>0 { body["generationConfig"]:=gen }; if has_key(o,"tools") { body["tools"]:=o["tools"] }; return {"url":ctx["provider"]["base_url"]+"/models/"+get(o,"model",get(ctx["provider"],"default_model",""))+":generateContent","method":"POST","headers":{"x-goog-api-key":ctx["credential"],"Content-Type":"application/json"},"protected_headers":["x-goog-api-key","Content-Type"],"body":to_json(body),"stream_mode":get(o,"stream",false)} }
func decode_chat(ctx) { d:=ctx["data"]; candidates:=get(d,"candidates",[]); c:={}; if len(candidates)>0 { c:=candidates[0] }; content:=get(c,"content",{}); text:=""; tools:=[]; for part in get(content,"parts",[]) { if has_key(part,"text") { text:=text+part["text"] }; if has_key(part,"functionCall") { fc:=part["functionCall"]; tools=push(tools,{"type":"function","function":{"name":get(fc,"name",""),"arguments":to_json(get(fc,"args",{}))}}) } }; u:=get(d,"usageMetadata",{}); input:=get(u,"promptTokenCount",0); output:=get(u,"candidatesTokenCount",0); reason:=get(c,"finishReason",""); if reason=="STOP" { reason:="stop" }; if reason=="MAX_TOKENS" { reason:="length" }; if len(tools)>0 { reason:="tool_calls" }; return {"ok":true,"request_id":get(ctx,"request_id",""),"model":get(ctx,"fallback_model",""),"output_text":text,"finish_reason":reason,"tool_calls":tools,"usage":{"input_tokens":input,"output_tokens":output,"total_tokens":input+output},"raw_provider":d} }
func decode_error(ctx) { d:=ctx["data"]; if type(d)!="dict" || !has_key(d,"error") { return {"ok":false,"matched":false} }; e:=d["error"]; return {"ok":false,"matched":true,"category":get(e,"status","provider"),"message":get(e,"message","Gemini request failed"),"provider_code":get(e,"code",0),"raw_provider":d} }
func decode_stream(ctx) { p:=parse_stream(get(ctx,"chunks",[]),get(ctx,"body_text","")); if !p["ok"] { return p }; text:=""; last:={}; for d in p["events"] { last:=d; for c in get(d,"candidates",[]) { for part in get(get(c,"content",{}),"parts",[]) { text:=text+get(part,"text","") } } }; return {"ok":true,"output_text":text,"finish_reason":"stop","usage":{"input_tokens":0,"output_tokens":0,"total_tokens":0},"raw_provider":{"stream_events":p["events"]}} }
func driver() { return {"contract":"ai-sdk-provider-driver","version":"1.0.0","id":"gemini-native","describe":describe,"validate":validate,"encode_chat":encode_chat,"decode_chat":decode_chat,"decode_error":decode_error,"decode_stream":decode_stream} }
export gemini_provider:=provider_impl
export gemini_driver:=driver
